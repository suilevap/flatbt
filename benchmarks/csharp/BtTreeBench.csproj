<Project Sdk="Microsoft.NET.Sdk">
  <!-- bt-tree is used the way its README says: its BTLib sources are compiled
       into this project unchanged. compare.sh fetches them into ./bt-tree. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="bt-tree/trunk/BehaviourTree/BTLib/**/*.cs" Exclude="bt-tree/trunk/BehaviourTree/BTLib/Properties/**" />
  </ItemGroup>
</Project>
